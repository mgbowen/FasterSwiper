load("@mgbowen_create_dmg//lib:defs.bzl", "macos_dmg")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcodeproj")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "FasterSwiper_lib",
    srcs = [
        "DaemonManager.swift",
        "FasterSwiperApp.swift",
        "SettingsStore.swift",
        "SettingsView.swift",
        "StoplightIcon.swift",
        "WindowTracker.swift",
    ],
    module_name = "FasterSwiper_App",
    deps = [
        "//src/public/swift",
    ],
)

xcodeproj(
    name = "xcodeproj",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            ":FasterSwiper_app",
            target_environments = [
                "device",
            ],
        ),
    ],
)

macos_application(
    name = "FasterSwiper_app",
    bundle_id = "com.mgbowen.FasterSwiper",
    bundle_name = "FasterSwiper",
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    deps = [
        ":FasterSwiper_lib",
        "@abseil-cpp//absl/log:flags",
    ],
)

macos_dmg(
    name = "FasterSwiper_dmg",
    src = ":FasterSwiper_app",
)

module(name = "faster-swiper")

bazel_dep(name = "apple_support", version = "2.5.3")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_xcodeproj", version = "4.0.1")
bazel_dep(name = "abseil-cpp", version = "20260107.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "protobuf", version = "34.1")
bazel_dep(name = "gutil", version = "20260309.0.bcr.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.17.1")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    declare_swift_deps_info = True,
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_deps_info",
    "swift_package",
    "swiftpkg_swift_protobuf",
)

# Override needed because the latest BCR release isn't compatible with Bazel 9
bazel_dep(name = "magic_enum")
git_override(
    module_name = "magic_enum",
    commit = "7d87efb4a3dddbbe8caa9ca14eff05ede1102ab8",
    remote = "https://github.com/Neargye/magic_enum.git",
)

